{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_TOOLS": "1",
        "EXPO_PUBLIC_BRAND_MODE": "real"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_TOOLS": "1",
        "EXPO_PUBLIC_BRAND_MODE": "original"
      }
    },
    "preview-personal": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DEV_TOOLS": "1",
        "EXPO_PUBLIC_BRAND_MODE": "real"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BRAND_MODE": "original"
      }
    },
    "production-personal": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_BRAND_MODE": "real"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
