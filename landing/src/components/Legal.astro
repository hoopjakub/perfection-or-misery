---
// Privacy and Terms on the site (the maintainer, 10 Oct 2026: "custom made
// for the website with the exact same content as the one in the app"). The
// words are the app's own file (src/data/legal.ts, copied into lib/game by
// scripts/build-landing-data.cjs), so the two can't drift; only the frame is
// the site's.
import Base from '../layouts/Base.astro'
import { legalDoc, updatedOn, CONTACT, type LegalPageId } from '../lib/game/legal'
import type { Lang } from '../i18n'
interface Props { lang: Lang; page: LegalPageId }
const { lang, page } = Astro.props
const { doc } = legalDoc(page, lang)
// The app's two lines around the text (src/i18n common.lastUpdated, .questions).
const updated = lang === 'sk' ? `Naposledy upravené ${updatedOn(lang)}` : `Last updated ${updatedOn(lang)}`
const asks = lang === 'sk' ? 'Otázky:' : 'Questions:'
// The description: the intro, kept inside the 120–170 characters a search result shows.
const long = doc.intro.length > 170 ? `${doc.intro.slice(0, 168).replace(/\s+\S*$/, '')}…` : doc.intro
const description = long.length >= 120 ? long : `${long} (Perfection or Misery, ${doc.title})`.slice(0, 170)
---
<Base lang={lang} page={page} title={`${doc.title} · Perfection or Misery`} description={description}>
  <article class="legal">
    <h1 class="super c-title">{doc.title}</h1>
    <p class="tag muted">{updated}</p>
    <p class="legal-intro">{doc.intro}</p>
    {doc.sections.map(s => (
      <section class="legal-section">
        <h2 class="c-head">{s.heading}</h2>
        {s.body.map(p => <p>{p}</p>)}
      </section>
    ))}
    <p class="legal-intro">{asks} <a href={`mailto:${CONTACT}`}>{CONTACT}</a></p>
  </article>
</Base>
