---
// The logo, inline, from the same paths as the app's opening and every icon
// (src/components/brand/logoParts.ts, generated from assets/Group 3.svg). The
// wordmark takes `currentColor`: white on nylon, ink on cotton (07 F1; white
// on cotton is 1.11:1). `compact`: the wordmark out and the gap closed, as on
// the app's icon.
import { LOGO } from '../../../src/components/brand/logoParts'
interface Props { compact?: boolean; class?: string; label?: string }
const { compact = false, class: cls, label = 'Perfection or Misery' } = Astro.props
const dy = compact ? LOGO.shift : 0
---
<svg class={cls} viewBox={LOGO.viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <g transform={`translate(0 ${dy})`}>
    <rect {...LOGO.stick} fill="#FF5A00" />
    <circle {...LOGO.head} fill="#FF5A00" />
    <circle {...LOGO.hole} fill="#000" />
    <path d={LOGO.volt} fill="#D5FF3F" />
  </g>
  <g transform={`translate(0 ${-dy})`}>
    <path d={LOGO.red} fill="#E1141F" />
  </g>
  {!compact && <path class="wordmark" d={LOGO.wordmark} fill="currentColor" />}
</svg>
