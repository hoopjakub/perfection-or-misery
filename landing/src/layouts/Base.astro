---
// Every page's shell (docs/website/09 §7, 11 §1): metadata, the language pair,
// the two grounds (cotton in light mode, nylon in dark, as the app), the top
// bar and the footer.
import '../styles/global.css'
import Logo from '../components/Logo.astro'
import Footer from '../components/Footer.astro'
import { T, other, pathFor, type Lang } from '../i18n'
import { CT } from '../community-i18n'
import { AUTH_KEYS } from '../lib/signin-form'

interface Props { lang: Lang; page?: string; title?: string; description?: string; jsonLd?: object; noindex?: boolean }
const { lang, page = '', title, description, jsonLd, noindex = false } = Astro.props
const t = T[lang]
const site = Astro.site!.toString().replace(/\/$/, '')
const here = `${site}${pathFor(lang, page)}`
const pair = { en: `${site}${pathFor('en', page)}`, sk: `${site}${pathFor('sk', page)}` }
const fullTitle = title ?? t.title
const desc = description ?? t.description
const c = CT[lang]
const auth = Object.fromEntries(AUTH_KEYS.map(k => [k, c[k]]))
// The tabs (the maintainer, 9 Oct 2026: the community is a tab beside home,
// easy to find, not a footer link).
const inCommunity = page === 'community' || page.startsWith('community/')
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={here} />}
    {!noindex && <link rel="alternate" hreflang="en" href={pair.en} />}
    {!noindex && <link rel="alternate" hreflang="sk" href={pair.sk} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={pair.en} />}
    <meta name="theme-color" content="#141416" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3F3F0" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Perfection or Misery" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/super.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/body.woff" as="font" type="font/woff" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Vercel Web Analytics and Speed Insights: the plain-HTML snippet, the site's own project (06 §5) -->
    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body>
    <header class="bar">
      <a class="brand opens-on-hover" href={pathFor(lang)} aria-label="Perfection or Misery">
        <Logo opens class="brand-mark" label="" />
      </a>
      <nav class="tabs" aria-label="Perfection or Misery">
        <a href={pathFor(lang)} aria-current={page === '' ? 'page' : undefined}>{c.home}</a>
        <a href={pathFor(lang, 'community')} aria-current={inCommunity ? 'page' : undefined}>{c.title}</a>
      </nav>
      <!-- Sign in, or who's signed in (scripts/header.ts). -->
      <div class="who" data-who></div>
      <!-- The flag of the language you're reading; a click switches to the other (the maintainer, 9 Oct 2026). -->
      <a class="lang" href={pathFor(other(lang), page)} hreflang={other(lang)} lang={other(lang)} aria-label={t.switchTo} title={t.switchTo}>
        <img src={`/flags/${lang}.png`} alt="" width="28" height="28" />
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script type="application/json" id="auth-strings" set:html={JSON.stringify(auth)} />
    <script>
      import '../scripts/header'
    </script>
  </body>
</html>
